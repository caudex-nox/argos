        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph LR\n    Usuario[\&quot;👤 Usuario / Operador\&quot;]\n\n    subgraph Sistema[\&quot;Sistema de Gestión de Usuarios y Tareas\&quot;]\n        UC_Seleccionar(\&quot;(1. Seleccionar registro en tabla)\&quot;)\n        UC_CargarForm(\&quot;(2. Cargar datos en formulario)\&quot;)\n        UC_Modificar(\&quot;(3. Modificar campos de usuario)\&quot;)\n        UC_Actualizar(\&quot;(4. Actualizar usuario)\&quot;)\n        UC_ValidarEdad(\&quot;(5. Validar edad - AgeSpinBox)\&quot;)\n        UC_Cifrar(\&quot;(6. Cifrar email - XOR + Base64)\&quot;)\n        UC_Persistir(\&quot;(7. Preparar query UPDATE)\&quot;)\n        UC_Refrescar(\&quot;(8. Refrescar UI y limpiar campos)\&quot;)\n    end\n\n    SQLite[\&quot;💾 Engine SQLite 3 / DB\&quot;]\n\n    %% Interacciones del Usuario\n    Usuario --&gt; UC_Seleccionar\n    Usuario --&gt; UC_Modificar\n    Usuario --&gt; UC_Actualizar\n\n    %% Relaciones internas (Includes)\n    UC_Seleccionar -.-&gt;|includes| UC_CargarForm\n    UC_Actualizar -.-&gt;|includes| UC_ValidarEdad\n    UC_Actualizar -.-&gt;|includes| UC_Cifrar\n    UC_Actualizar -.-&gt;|includes| UC_Persistir\n    UC_Actualizar -.-&gt;|includes| UC_Refrescar\n\n    %% Interacción con el Sistema Secundario / Base de Datos\n    UC_Persistir --&gt;|sqlite3_step| SQLite&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="C-Pvl6qguvrcTfvFHOdS-1005">
