        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ==========================================\n    %% DIAGRAMA DE FLUJO SIMPLIFICADO - SISTEMA ARGOS\n    %% Proporción estimada: 3/4 de hoja A4\n    %% ==========================================\n\n    Inicio([\&quot;Inicio: main()\&quot;]) --&gt; Init[\&quot;Inicializar aplicación y base de datos&lt;br/&gt;• Abre conexión SQLite (usuarios_tareas.db)&lt;br/&gt;• Crea tabla e índices si no existen\&quot;]\n    Init --&gt; Cargar[\&quot;Cargar registros iniciales&lt;br/&gt;(Descifrado al vuelo de emails vía XOR + Base64)\&quot;]\n    Cargar --&gt; Mostrar[\&quot;Mostrar Ventana Principal (MainWindow)\&quot;]\n\n    Mostrar --&gt; Accion{\&quot;Acción del Usuario\&quot;}\n\n    %% Rama Insertar / Actualizar\n    Accion -- \&quot;Insertar / Actualizar\&quot; --&gt; Validar{\&quot;¿Datos válidos?&lt;br/&gt;• Campos requeridos no vacíos&lt;br/&gt;• Edad entre 18 y 60 (AgeSpinBox)&lt;br/&gt;• Nombre y email con formato válido\&quot;}\n    Validar -- \&quot;Inválido\&quot; --&gt; Alerta[\&quot;Mostrar aviso de error&lt;br/&gt;(QMessageBox::warning)\&quot;]\n    Alerta --&gt; Mostrar\n    Validar -- \&quot;Válido\&quot; --&gt; Cifrar[\&quot;Cifrar correo electrónico&lt;br/&gt;(XOR 0x6C + Base64)\&quot;]\n    Cifrar --&gt; Persistir[\&quot;Guardar registro en SQLite&lt;br/&gt;(INSERT / UPDATE parametrizado)\&quot;]\n\n    %% Rama Filtrar\n    Accion -- \&quot;Filtrar por Estado\&quot; --&gt; ConsultaFiltro[\&quot;Consultar SQLite con filtro&lt;br/&gt;(WHERE estado = ?)\&quot;]\n    ConsultaFiltro --&gt; ActualizarTabla[\&quot;Actualizar tabla visual&lt;br/&gt;(QTableWidget)\&quot;]\n\n    %% Rama Eliminar\n    Accion -- \&quot;Eliminar Registro\&quot; --&gt; Borrar[\&quot;Eliminar fila en SQLite por ID&lt;br/&gt;(DELETE FROM usuarios)\&quot;]\n\n    %% Rama Limpiar\n    Accion -- \&quot;Limpiar Formulario\&quot; --&gt; ResetForm[\&quot;Restablecer formulario a valores por defecto\&quot;]\n    ResetForm --&gt; Mostrar\n\n    %% Ciclos de retorno\n    Persistir --&gt; ActualizarTabla\n    Borrar --&gt; ActualizarTabla\n    ActualizarTabla --&gt; ResetForm\n\n    %% Cierre\n    Accion -- \&quot;Cerrar Ventana\&quot; --&gt; Cierre[\&quot;Cerrar conexión SQLite y liberar memoria\&quot;]\n    Cierre --&gt; Fin([\&quot;Fin\&quot;])\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="C-Pvl6qguvrcTfvFHOdS-642">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
